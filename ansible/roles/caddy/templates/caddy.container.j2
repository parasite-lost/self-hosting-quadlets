[Unit]
Description=caddy reverse proxy
AssertPathIsDirectory={{ caddy_dir_config }}
AssertPathExists={{ caddy_dir_config }}/Caddyfile
Requires=caddy.socket
After=caddy.socket

[Service]
ExecReload=podman exec caddy /usr/bin/caddy reload --config /etc/caddy/Caddyfile

[Container]
ContainerName=caddy
Label=app=caddy

# built locally by caddy.build (caddy-build.service). Not referenced as
# Image=caddy.build (avoid the rebuild stopping caddy during the rebuild)
Image={{ caddy_image_name }}
# rebuilt images are rolled out by podman-auto-update.timer
AutoUpdate=local
Notify=true
ReadOnly=true

Exec=/usr/bin/caddy run --config /etc/caddy/Caddyfile

NoNewPrivileges=true

Volume={{ caddy_dir_config }}:/etc/caddy:ro,Z
Volume=caddy-config.volume:/config
Volume=caddy-data.volume:/data
{{ 'Volume=%d:/run/credentials:ro,Z,nodev,nosuid,noexec' if _caddy_has_credentials }}

[Install]
WantedBy=default.target
