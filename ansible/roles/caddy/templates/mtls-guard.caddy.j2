(mtls_required) {
	# enforce mTLS certificate
	# args[0]: pem CA certificate name
	tls {
		client_auth {
			mode require_and_verify
			trust_pool file {
				pem_file /etc/caddy/certs/{args[0]}
			}
		}
	}
}

(reverse_proxy_with_mtls) {
	# reverse_proxy with required mTLS certificate
	# args[0]: subdomain
	# args[1]: proxy port
	# args[2]: pem CA certificate name
	{args[0]}.{{ host_maindomain }} {
		import default_site_settings

		import mtls_required {args[2]}

		reverse_proxy {args[1]}
	}
}
