d1-mtls-public.example.com {
	encode
	header {
		X-Robots-Tag "noindex,nofollow"
		defer
	}
	tls {
		client_auth {
			# enforcing mTLS exclusively for public remote IPs requires using json config
			mode require_and_verify
			trust_pool file {
				pem_file /etc/caddy/certs/root@common.example.com.pem
			}
		}
	}

	reverse_proxy 127.0.0.1:3331
}
