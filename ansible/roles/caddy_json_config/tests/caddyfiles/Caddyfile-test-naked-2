{
	acme_dns cloudflare {file./run/credentials/api-token}

	default_bind fd/4 {
		protocols h1 h2
	}

	default_bind fdgram/5 {
		protocols h3
	}
}

http:// {
	bind fd/3 {
		protocols h1
	}
	redir https://{host}{uri} permanent
}

*.example.com {
	abort
}

a1-naked.example.com {
	encode
	header {
		X-Robots-Tag "noindex,nofollow"
		defer
	}
	reverse_proxy 127.0.0.1:9091
}

a2-naked.example.com {
	encode
	header {
		X-Robots-Tag "noindex,nofollow"
		defer
	}
	reverse_proxy 127.0.0.1:8080
}
