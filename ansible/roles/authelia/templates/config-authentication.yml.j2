# First Factor https://www.authelia.com/configuration/first-factor/file/
authentication_backend:
  file:
    path: /config/user_database.yml
    extra_attributes:
      immich_quota:
        multi_valued: false
        value_type: string
      immich_role:
        multi_valued: false
        value_type: string
  password_reset:
    disable: true
  password_change:
    disable: false

identity_providers:
  oidc:
    ## See: https://www.authelia.com/c/oidc
    # hmac_secret: set via AUTHELIA_IDENTITY_PROVIDERS_OIDC_HMAC_SECRET_FILE
    jwks:
      - key: {{ '{{' }} secret "/run/credentials/{{ authelia_oidc_jwk_key_name }}" | mindent 10 "|" | msquote {{ '}}' }}

    claims_policies:
      immich_policy:
        custom_claims:
          immich_quota:
            attribute: 'immich_quota'
          immich_role:
            attribute: 'immich_role'

    scopes:
      immich_scope:
        claims:
          - 'immich_quota'
          - 'immich_role'

    lifespans:
      custom:
        opencloud:
          access_token: '60m'
          refresh_token: '90m'

    # enable global CORS for OIDC endpoints
    cors:
      endpoints:
        - 'authorization'
        - 'token'
        - 'revocation'
        - 'introspection'
        - 'userinfo'
      allowed_origins:
        - 'https://{{ opencloud_subdomain }}.{{ host_maindomain }}'

    clients:
      - client_id: 'immich'
        client_name: '{{ immich_subdomain }}.{{ host_maindomain }}'
        # https://www.authelia.com/integration/openid-connect/frequently-asked-questions/#how-do-i-generate-a-client-identifier-or-client-secret
        # podman run --rm authelia/authelia:latest authelia crypto hash generate pbkdf2 --variant sha512 --random --random.length 72 --random.charset rfc3986
        client_secret: '{{ immich_client_secret_hash }}'
        public: false
        authorization_policy: 'two_factor'
        require_pkce: false
        redirect_uris:
          - 'https://{{ immich_subdomain }}.{{ host_maindomain }}/auth/login'
          - 'https://{{ immich_subdomain }}.{{ host_maindomain }}/user-settings'
          - 'app.immich:///oauth-callback'
        claims_policy: 'immich_policy'
        scopes:
          - 'openid'
          - 'profile'
          - 'email'
          - 'immich_scope'
        consent_mode: 'pre-configured'
        pre_configured_consent_duration: '1 year'
        response_types:
          - 'code'
        grant_types:
          - 'authorization_code'
        id_token_signed_response_alg: 'RS256'
        userinfo_signed_response_alg: 'RS256'
        token_endpoint_auth_method: 'client_secret_post'

      - client_id: 'opencloud-web-id'
        client_name: '{{ opencloud_subdomain }}.{{ host_maindomain }}'
        public: true
        authorization_policy: 'two_factor'
        require_pkce: true
        redirect_uris:
          - 'https://{{ opencloud_subdomain }}.{{ host_maindomain }}/'
          - 'https://{{ opencloud_subdomain }}.{{ host_maindomain }}/oidc-callback.html'
          - 'https://{{ opencloud_subdomain }}.{{ host_maindomain }}/oidc-silent-redirect.html'
        scopes:
          - 'openid'
          - 'profile'
          - 'email'
          - 'groups'
        consent_mode: 'pre-configured'
        pre_configured_consent_duration: '1 year'
        userinfo_signed_response_alg: 'RS256'
        access_token_signed_response_alg: 'RS256'
