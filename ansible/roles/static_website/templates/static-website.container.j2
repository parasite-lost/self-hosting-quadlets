[Unit]
Description=Static website served with caddy
AssertPathExists={{ static_website_dir_config }}/Caddyfile
AssertPathExists={{ static_website_dir_www }}
Requires=static-website.socket
After=static-website.socket

[Service]
Restart=on-failure

[Container]
ContainerName=static-website
Label=app=static-website

Image=docker.io/library/caddy:2
#AutoUpdate=registry
Notify=true
ReadOnly=true

Exec=/usr/bin/caddy run --config /etc/caddy/Caddyfile

NoNewPrivileges=true
DropCapability=all
# not used (port via socket activation), but /usr/bin/caddy carries the file
# capability cap_net_bind_service=+ep: exec fails if it is not in the bounding set
AddCapability=NET_BIND_SERVICE

# no persistent data needed (/config, /data)
Volume={{ static_website_dir_config }}:/etc/caddy:ro,Z,nodev,nosuid,noexec
Volume={{ static_website_dir_www }}:/www:ro,Z,nodev,nosuid,noexec

[Install]
WantedBy=default.target
