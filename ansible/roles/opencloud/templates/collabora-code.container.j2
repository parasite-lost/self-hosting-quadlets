[Unit]
Description=Collabora CODE container

[Service]
Restart=always
TimeoutStartSec=300

[Container]
Pod=collabora.pod
Label=app=collabora
ContainerName=collabora-code

Image=docker.io/collabora/code:{{ opencloud_collabora_version }}
#AutoUpdate=registry
# image defines a HEALTHCHECK (coolwsd --probe every 30s), not used
HealthCmd=none

# document jails are created by coolforkit-ns in its own user/mount namespace
# (full capabilities inside that namespace)
NoNewPrivileges=true
DropCapability=all
# not used (coolwsd runs as non-root user, NoNewPrivileges prevents gaining file
# capabilities), but coolforkit-caps carries the file capabilities
# cap_chown,cap_fowner,cap_sys_chroot=ep: exec fails if they are not in the bounding set
AddCapability=CHOWN FOWNER SYS_CHROOT

ReadOnly=true
# fontconfig cache in home of cool user (U=true: owned by container user)
Mount=type=tmpfs,destination=/opt/cool/.cache,U=true
# document jails, recreated on every start
Mount=type=tmpfs,destination=/opt/cool/child-roots,U=true

# TLS is handled by reverse proxy
Environment=DONT_GEN_SSL_CERT=true
# allow OpenCloud as wopi server
# Alternative A: public URI (requires hop via reverse proxy, ignore self-signed certificate issue in case of localhost deployment)
#Environment=aliasgroup1=https://{{ opencloud_opencloud_subdomain }}.{{ host_maindomain }}
#Environment="extra_params=--o:ssl.enable=false --o:ssl.termination=true{{ ' --o:ssl.ssl_verification=false' if deploy_purpose == 'development' }}"
# Alternative B: host loopback URI (direct communication, no TLS overhead, client must receive public URIs though)
Environment=aliasgroup1=http://127.0.0.1:{{ opencloud_opencloud_port }}
# ssl.enable=false: do not handle TLS
# ssl.terminate=true: hand out https URIs to clients
# server_name=...: set the actual server name for URIs sent to client (do not use 127.0.0.1:{{ opencloud_opencloud_port }})
# net.frame_ancestors=...: required for CSP (by default only allows 127.0.0.1:{{ opencloud_opencloud_port }})
Environment="extra_params=--o:ssl.enable=false --o:ssl.termination=true --o:server_name={{ opencloud_collabora_subdomain }}.{{ host_maindomain }} --o:net.frame_ancestors=https://{{ opencloud_opencloud_subdomain }}.{{ host_maindomain }}"

# admin credentials for admin interface:
# https://{{ opencloud_collabora_subdomain }}.{{ host_maindomain }}/browser/dist/admin/admin.html
Environment=username={{ opencloud_collabora_admin_user }}
Secret=collabora_admin_password,type=env,target=password

# WOPI proof key, make accessible to collabora user
Secret=collabora_proof_key,type=mount,target=/etc/coolwsd/proof_key,uid={{ opencloud_collabora_uid }},gid={{ opencloud_collabora_gid }},mode=0400
